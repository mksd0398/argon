<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later show the system's splash screen: the logo on its background colour. The window behind it
         is that colour too, so nothing flashes between the splash and the app's first frame. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launcher_foreground</item>
        <item name="android:windowBackground">@color/launcher_background</item>
    </style>
</resources>

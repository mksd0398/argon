<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Not a real Firebase app. CI generates a demo project named "analytics" with it (bundle id com.mockshop.analytics)
     to compile the iOS Firebase sink against the SDK: .github/workflows/ci.yml. -->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>not-a-real-key</string>
	<key>BUNDLE_ID</key>
	<string>com.mockshop.analytics</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000</string>
	<key>PROJECT_ID</key>
	<string>argon-ci</string>
</dict>
</plist>

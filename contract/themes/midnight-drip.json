        {
          "id": "shop",
          "title": "Shop",
          "icon": "grid"
        },
        {
          "id": "search",
          "title": "Search",
          "icon": "search"
        },
        {
          "id": "wishlist",
          "title": "Wishlist",
          "icon": "heart"
